APP_NAME=ConvoCoach API
APP_ENVIRONMENT=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO
OPENAPI_ENABLED=true
OPERATIONAL_CHECKS_ENABLED=false
MAX_REQUEST_BODY_BYTES=1048576
ALLOWED_HOSTS=testserver,localhost,127.0.0.1

POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=convocoach
POSTGRES_PASSWORD=convocoach_local_only
POSTGRES_DB=convocoach
DATABASE_URL=postgresql+asyncpg://convocoach:convocoach_local_only@127.0.0.1:5432/convocoach

REDIS_HOST_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CA_CERTIFICATE_PATH=

# Local-only mock identity. Production environments fail closed without a
# provider-backed AuthenticationVerifier.
DEVELOPMENT_AUTH_TOKEN=convocoach-local-token
DEVELOPMENT_AUTH_SUBJECT=local-user
DEVELOPMENT_AUTH_EMAIL=local@convocoach.invalid
AUTHENTICATION_VERIFIER_MODE=development
AUTHENTICATION_ISSUER=
AUTHENTICATION_AUDIENCE=
AUTHENTICATION_JWKS_URL=
AUTHENTICATION_ALLOWED_ALGORITHMS=ES256,RS256
AUTHENTICATION_CLOCK_SKEW_SECONDS=60
AUTHENTICATION_MAXIMUM_TOKEN_LIFETIME_SECONDS=3600

# AI remains disabled by default. Use AI_PROVIDER_MODE=mock with both flags true
# only for the deterministic local preview. For tiered hosted development or
# staging, use AI_PROVIDER_MODE=openrouter_tiered, keep mock execution false,
# and supply the OpenRouter key and pseudonym secret from Keychain or a secret manager.
AI_COACHING_ENABLED=false
AI_MOCK_EXECUTION_ENABLED=false
AI_PROVIDER_MODE=mock
# Production external AI fails closed unless independent processor/privacy and
# provider-independent safety reviews have both been explicitly approved.
AI_EXTERNAL_PROCESSING_APPROVED=false
AI_SAFETY_EVALUATION_APPROVED=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_SAFETY_IDENTIFIER_SECRET=
ZAI_MODEL=glm-5.2
ZAI_REQUEST_TIMEOUT_SECONDS=30
ZAI_API_KEY=
ZAI_USER_IDENTIFIER_SECRET=
OPENROUTER_FREE_MODEL=openai/gpt-4o-mini
OPENROUTER_PAID_MODEL=openai/gpt-5.6-terra
OPENROUTER_FREE_REASONING_EFFORT=none
OPENROUTER_PAID_REASONING_EFFORT=medium
OPENROUTER_REQUEST_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=
OPENROUTER_USER_IDENTIFIER_SECRET=
AI_USAGE_ENFORCEMENT_ENABLED=false
AI_NEW_REQUESTS_PER_MINUTE=5
AI_RESERVATION_COST_MICROUSD=100000
AI_USER_MONTHLY_BUDGET_MICROUSD=2000000
AI_GLOBAL_MONTHLY_BUDGET_MICROUSD=100000000
AI_BUDGET_ALERT_PERCENT=80
# Pricing is explicit runtime configuration and must be reviewed against the
# current official model page before any controlled launch.
OPENAI_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=2500000
OPENAI_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=15000000
ZAI_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=1400000
ZAI_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=4400000
OPENROUTER_FREE_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=150000
OPENROUTER_FREE_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=600000
OPENROUTER_PAID_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=1000000
OPENROUTER_PAID_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=6000000

# Store billing remains disabled for local development. Sandbox qualification
# may enable it with test products and either a short-lived service-account key
# outside source control or Application Default Credentials.
STORE_BILLING_ENABLED=false
STORE_TRANSACTION_HASH_SECRET=
STORE_VERIFICATION_TIMEOUT_SECONDS=15
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_APP_ID=0
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_IAP_PRODUCT_IDS=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_PRODUCT_IDS=
GOOGLE_PLAY_USE_APPLICATION_DEFAULT_CREDENTIALS=false
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=

# Production must use APP_ENVIRONMENT=production, APP_DEBUG=false,
# OPENAPI_ENABLED=false, OPERATIONAL_CHECKS_ENABLED=true, a bounded request
# limit, explicit non-local ALLOWED_HOSTS, PostgreSQL over the async driver,
# TLS-protected Redis, no development identity values, production_contract
# authentication mode with exact HTTPS issuer/JWKS metadata and audience, and
# mock execution disabled. Production external AI additionally requires usage
# enforcement, reviewed pricing/ceilings, provider credentials, a pseudonym
# secret, explicit processing consent, AI_EXTERNAL_PROCESSING_APPROVED=true,
# and AI_SAFETY_EVALUATION_APPROVED=true. Release remains blocked until identity,
# billing, safety, monitoring, and device gates pass.
# Supply deployment secrets through the environment or secret manager; never
# add production credentials to this example.
