modules = ["python-3.12", "swift-5.8", "ruby-3.2", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd backend && export DATABASE_URL=\"$(echo \"$DATABASE_URL\" | sed \"s|^postgresql://|postgresql+asyncpg://|; s|^postgres://|postgresql+asyncpg://|\" | sed \"s|[?&]sslmode=[^&]*||\")\"; python3 -m alembic upgrade head && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 5000'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
